<!--
    Auxilium tema za WPF (GPO Studio).
    Vrijednosti su iz Auxilium stil-kita (auxilium-tokeni.css, www.auxilium.hr):
    tri razine tamnih površina, obrub 1 px u boji Line, odsječeni kutovi (gore-lijevo i dolje-desno),
    jantarni kutni nosači na karticama, jedna primarna (jantarna) radnja po području.
    Odsječeni kut: OpacityMask s gradijentom u apsolutnim koordinatama reže kut gore-lijevo;
    unutarnji sloj zakrenut za 180° istim trikom reže kut dolje-desno. Dijagonalu obruba crta Path.
    Fontovi: Bahnschrift / Segoe UI / Consolas (zamjenski fontovi kita); Orbitron, Sora i IBM Plex Mono
    koriste se ako postoje u mapi Fonts uz GUI (vidi Start-GpoStudio.ps1).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Paleta (www.auxilium.hr) ===== -->
    <Color x:Key="VoidColor">#090C14</Color>
    <Color x:Key="PanelColor">#111826</Color>
    <Color x:Key="Panel2Color">#161F30</Color>
    <Color x:Key="LineColor">#2A3550</Color>
    <Color x:Key="TextColor">#E8ECF5</Color>
    <Color x:Key="MutedColor">#8B93A9</Color>
    <Color x:Key="Muted2Color">#828AA0</Color>
    <Color x:Key="AmberColor">#FFC94A</Color>
    <Color x:Key="AmberDimColor">#C99A3A</Color>
    <Color x:Key="CyanColor">#5FD8C9</Color>
    <Color x:Key="RedColor">#FF4B4B</Color>
    <Color x:Key="GreenColor">#6FE08A</Color>

    <SolidColorBrush x:Key="Void" Color="{StaticResource VoidColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Muted2" Color="{StaticResource Muted2Color}"/>
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="AmberDim" Color="{StaticResource AmberDimColor}"/>
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="LogoRed" Color="#E63946"/>
    <SolidColorBrush x:Key="OnAmber" Color="#131313"/>
    <SolidColorBrush x:Key="NavActive" Color="#1B263B"/>
    <SolidColorBrush x:Key="Select" Color="#1F2B42"/>
    <SolidColorBrush x:Key="RowAlt" Color="#0C101B"/>
    <SolidColorBrush x:Key="HeaderLine" Color="#B9FFC94A"/>
    <SolidColorBrush x:Key="Star" Color="#E8ECF5"/>
    <SolidColorBrush x:Key="SavjetFill" Color="#152A2A"/>
    <SolidColorBrush x:Key="PaziFill" Color="#26231B"/>
    <SolidColorBrush x:Key="OpasnoFill" Color="#2A1A20"/>

    <!-- ===== Fontovi ===== -->
    <FontFamily x:Key="FontNaslov">Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontTekst">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Cascadia Mono, Courier New</FontFamily>
    <FontFamily x:Key="FontGumb">Segoe UI</FontFamily>

    <!-- Maske odsječenog kuta (gore-lijevo; unutarnji zakrenuti sloj daje dolje-desno) -->
    <LinearGradientBrush x:Key="Rez14" MappingMode="Absolute" StartPoint="0,0" EndPoint="14,14">
        <GradientStop Color="Transparent" Offset="0.5"/>
        <GradientStop Color="Black" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rez10" MappingMode="Absolute" StartPoint="0,0" EndPoint="10,10">
        <GradientStop Color="Transparent" Offset="0.5"/>
        <GradientStop Color="Black" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rez8" MappingMode="Absolute" StartPoint="0,0" EndPoint="8,8">
        <GradientStop Color="Transparent" Offset="0.5"/>
        <GradientStop Color="Black" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rez6" MappingMode="Absolute" StartPoint="0,0" EndPoint="6,6">
        <GradientStop Color="Transparent" Offset="0.5"/>
        <GradientStop Color="Black" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rez5" MappingMode="Absolute" StartPoint="0,0" EndPoint="5,5">
        <GradientStop Color="Transparent" Offset="0.5"/>
        <GradientStop Color="Black" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- ===== Tekst ===== -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="EyebrowPrigusen" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Naslov" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontNaslov}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Tekst" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTekst}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TekstPrigusen" TargetType="TextBlock" BasedOn="{StaticResource Tekst}">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Sitno" TargetType="TextBlock" BasedOn="{StaticResource Tekst}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Nagovjestaj" TargetType="TextBlock" BasedOn="{StaticResource Sitno}">
        <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
    </Style>

    <!-- ===== Gumb (Panel2 ispuna, Line obrub, rez 8 px; hover jantarni obrub i tekst) ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontGumb}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="17,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid OpacityMask="{StaticResource Rez8}">
                            <Grid OpacityMask="{StaticResource Rez8}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                <Border x:Name="ploha" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </Grid>
                        <Path x:Name="dijagonala1" Data="M0.5,8 L8,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path x:Name="dijagonala2" Data="M0,7.5 L7.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Panel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
                            <Setter Property="Background" Value="{StaticResource Panel2}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GumbPrimarni" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Amber}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAmber}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AmberDim}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AmberDim}"/>
                <Setter Property="Foreground" Value="{StaticResource OnAmber}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GumbOpasni" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
        <Setter Property="Foreground" Value="{StaticResource Red}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Red}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
                <Setter Property="Foreground" Value="{StaticResource Void}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GumbTraka" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Tekstni gumb (poveznica) -->
    <Style x:Key="GumbPoveznica" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segment: izbor jedne opcije (RadioButton kao gumb, rez 6 px) ===== -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontGumb}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid OpacityMask="{StaticResource Rez6}">
                            <Grid OpacityMask="{StaticResource Rez6}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </Grid>
                        <Path Data="M0.5,6 L6,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,5.5 L5.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavActive}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Kartica razine zaštite (RadioButton, rez 14 px, nosači kad je odabrana) ===== -->
    <Style x:Key="RazinaKartica" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Padding" Value="16,14,16,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid OpacityMask="{StaticResource Rez14}">
                            <Grid OpacityMask="{StaticResource Rez14}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </Grid>
                        <Path Data="M0.5,14 L14,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,13.5 L13.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <Grid x:Name="nosaci" Visibility="Collapsed">
                            <Rectangle Width="12" Height="2" Fill="{StaticResource Amber}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Rectangle Width="2" Height="12" Fill="{StaticResource Amber}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Rectangle Width="12" Height="2" Fill="{StaticResource Amber}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Rectangle Width="2" Height="12" Fill="{StaticResource Amber}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavActive}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                            <Setter TargetName="nosaci" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigacija (RadioButton: glif u odsječenom okviru + naziv, jantarna crta kad je aktivna) ===== -->
    <Style x:Key="NavStavka" TargetType="RadioButton">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontNaslov}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="crta" Width="3" Fill="{StaticResource Amber}" HorizontalAlignment="Left" Margin="0,5" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                            <Grid Width="32" Height="22">
                                <Grid OpacityMask="{StaticResource Rez5}">
                                    <Grid OpacityMask="{StaticResource Rez5}" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </Grid>
                                <Path Data="M0.5,5 L5,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Path Data="M0,4.5 L4.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="glif" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11"
                                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Panel2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavActive}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                            <Setter TargetName="glif" Property="Foreground" Value="{StaticResource Amber}"/>
                            <Setter TargetName="crta" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Kvačica (14 px, Void ispuna; uključeno: jantarni obrub i kvačica) ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontTekst}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="okvir" Width="18" Height="18" Background="{StaticResource Void}" BorderBrush="{StaticResource Muted2}" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="kvacica" Data="M3,9 L7,13 L14,4" Stroke="{StaticResource Amber}" StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="okvir" Property="BorderBrush" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="okvir" Property="BorderBrush" Value="{StaticResource Amber}"/>
                            <Setter TargetName="kvacica" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="okvir" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Veliki prekidač kvačicom za kontrolu (bez natpisa) -->
    <Style x:Key="KvacicaVelika" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontFamily" Value="{StaticResource FontGumb}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Polje za unos (Void, obrub Line, fokus Cyan; Tag = nagovještaj kad je prazno) ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Void}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AmberDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontTekst}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Grid OpacityMask="{StaticResource Rez6}">
                            <Grid OpacityMask="{StaticResource Rez6}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </Grid>
                        <Path Data="M0.5,6 L6,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,5.5 L5.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="nagovjestaj" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted2}" FontSize="{TemplateBinding FontSize}"
                                   Margin="9,0,6,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="nagovjestaj" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Muted2}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Klizači (tanki, staza Void, palac Line) ===== -->
    <Style x:Key="KlizacGumb" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlizacPalac" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="palac" Background="{StaticResource Line}" Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="palac" Property="Background" Value="{StaticResource Muted2}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="palac" Property="Background" Value="{StaticResource Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource KlizacGumb}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource KlizacPalac}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource KlizacGumb}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource KlizacGumb}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource KlizacPalac}"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource KlizacGumb}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Oblačić ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontTekst}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Traka napretka (6 px; neodređeno = jantarni segment koji putuje) ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Rectangle x:Name="PART_Track"/>
                        <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        <Rectangle x:Name="putnik" Fill="{TemplateBinding Foreground}" Width="180" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Rectangle.RenderTransform><TranslateTransform X="-180"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="putnik" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="putovanje">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="putnik" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-180" To="1800" Duration="0:0:1.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="putovanje"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Kartica (HeaderedContentControl): rez 14 px, jantarni nosači, eyebrow naslov ===== -->
    <Style x:Key="Kartica" TargetType="HeaderedContentControl">
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="14,36,14,14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid OpacityMask="{StaticResource Rez14}">
                            <Grid OpacityMask="{StaticResource Rez14}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </Grid>
                        <Path Data="M0.5,14 L14,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,13.5 L13.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <Rectangle Width="12" Height="2" Fill="{StaticResource Amber}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Rectangle Width="2" Height="12" Fill="{StaticResource Amber}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Rectangle Width="12" Height="2" Fill="{StaticResource Amber}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Rectangle Width="2" Height="12" Fill="{StaticResource Amber}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <ContentPresenter ContentSource="Header" Margin="16,10,16,0" VerticalAlignment="Top" TextBlock.FontFamily="{StaticResource FontMono}"
                                          TextBlock.FontWeight="Bold" TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource Amber}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Redak kontrole (rez 10 px, traka razine 3 px uz lijevi rub; Tag = boja trake) -->
    <Style x:Key="RedakKontrole" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="18,12,14,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid OpacityMask="{StaticResource Rez10}">
                            <Grid OpacityMask="{StaticResource Rez10}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </Grid>
                        <Path Data="M0.5,10 L10,0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,9.5 L9.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <Rectangle Width="3" Fill="{TemplateBinding Tag}" HorizontalAlignment="Left" Margin="1,12,0,12"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Čip: obrub u boji teksta (prozirnost 60 %), kvadratna točka 6 x 6, mono VELIKA slova -->
    <Style x:Key="Cip" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0.6"/>
                        <StackPanel Orientation="Horizontal" Margin="9,0" VerticalAlignment="Center">
                            <Rectangle Width="6" Height="6" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontMono}"
                                       FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Oznaka (18 px): bez točke s obrubom Line, ili s točkom u boji (Osnovno / Preporučeno / Strogo / restart) -->
    <Style x:Key="Oznaka" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="7,0">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontMono}"
                                   FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OznakaTocka" TargetType="ContentControl" BasedOn="{StaticResource Oznaka}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Padding="7,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="6" Height="6" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="5,0,0,0" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontMono}"
                                       FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Okviri napomena (lijeva traka 3 px) -->
    <Style x:Key="OkvirSavjet" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
        <Setter Property="Background" Value="{StaticResource SavjetFill}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="12,10,14,11"/>
    </Style>
    <Style x:Key="OkvirPazi" TargetType="Border" BasedOn="{StaticResource OkvirSavjet}">
        <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        <Setter Property="Background" Value="{StaticResource PaziFill}"/>
    </Style>
    <Style x:Key="OkvirOpasno" TargetType="Border" BasedOn="{StaticResource OkvirSavjet}">
        <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
        <Setter Property="Background" Value="{StaticResource OpasnoFill}"/>
    </Style>

    <!-- ===== Popisi ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="pozadina" Background="Transparent">
                        <Rectangle x:Name="crta" Width="3" Fill="{StaticResource Amber}" HorizontalAlignment="Left" Margin="0,5" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pozadina" Property="Background" Value="{StaticResource Panel2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="pozadina" Property="Background" Value="{StaticResource NavActive}"/>
                            <Setter TargetName="crta" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tablica ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Void}"/>
        <Setter Property="RowBackground" Value="{StaticResource Void}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAlt}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <!-- Redoslijed (odstupanja i promjene prvo) postavlja kod; zaglavlja nemaju strelicu sortiranja. -->
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="MinRowHeight" Value="28"/>
        <Setter Property="FontFamily" Value="{StaticResource FontTekst}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>
    <!-- Ćelija s prelamanjem dugog teksta (ElementStyle stupca) -->
    <Style x:Key="CelijaPrelom" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Select}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Stablo (napredni uređivač) ===== -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource Void}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="2,2"/>
    </Style>

    <!-- Sustavne boje odabira (stablo, padajući popisi) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1F2B42"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8ECF5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1B263B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8ECF5"/>

    <!-- Padajući popis zadržava sustavni (svijetli) izgled; koristi se samo u dijalogu elemenata politike -->
    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>
</ResourceDictionary>
