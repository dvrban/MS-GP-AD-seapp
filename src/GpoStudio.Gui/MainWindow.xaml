<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPO Studio · Auxilium Informatika" Height="860" Width="1320" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Void}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontTekst}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="rootGrid" Background="{StaticResource Void}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ===== Zaglavlje: logotip, naziv proizvoda, čipovi, zvjezdice, jantarna linija ===== -->
        <Grid Grid.Row="0" Background="{StaticResource Panel}" ClipToBounds="True">
            <Canvas x:Name="hdrStars" IsHitTestVisible="False"/>
            <DockPanel Margin="18,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource FontNaslov}" FontWeight="Bold" FontSize="29" VerticalAlignment="Center">
                        <Run Text="AU" Foreground="{StaticResource Text}"/><Run Text="X" Foreground="{StaticResource LogoRed}"/><Run Text="ILIUM" Foreground="{StaticResource Text}"/><Run Text="." Foreground="{StaticResource Amber}"/>
                    </TextBlock>
                    <TextBlock Text="I N F O R M A T I K A" Foreground="{StaticResource Muted}" FontSize="12" Margin="14,9,0,0" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="34" Fill="{StaticResource Line}" Margin="26,0,22,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GPO STUDIO" FontFamily="{StaticResource FontNaslov}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Sigurnosne postavke računala i domene" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl x:Name="chipLevel" Style="{StaticResource Cip}" Foreground="{StaticResource Amber}" Content="RAZINA: PREPORUČENO" Margin="0,0,8,0"/>
                    <ContentControl x:Name="chipTarget" Style="{StaticResource Cip}" Foreground="{StaticResource Cyan}" Content="CILJ: OVO RAČUNALO" Margin="0,0,8,0"/>
                    <ContentControl x:Name="chipAdmin" Style="{StaticResource Cip}" Foreground="{StaticResource Cyan}" Content="ADMINISTRATOR"/>
                </StackPanel>
            </DockPanel>
            <Rectangle Height="1" Fill="{StaticResource HeaderLine}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- ===== Traka napretka i cilj primjene ===== -->
        <StackPanel Grid.Row="1">
            <ProgressBar x:Name="pbBusy" IsIndeterminate="False" Visibility="Hidden"/>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,7,18,7">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="CILJ" Style="{StaticResource EyebrowPrigusen}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <RadioButton x:Name="rbTargetLocal" Style="{StaticResource Segment}" GroupName="cilj" Content="OVO RAČUNALO" IsChecked="True"
                                 ToolTip="Postavke se upisuju u lokalni Group Policy računala na kojem radite."/>
                    <RadioButton x:Name="rbTargetRemote" Style="{StaticResource Segment}" GroupName="cilj" Content="DRUGA RAČUNALA"
                                 ToolTip="Lokalni Group Policy jednog ili više računala u mreži (preko PowerShell Remotinga)."/>
                    <RadioButton x:Name="rbTargetDomain" Style="{StaticResource Segment}" GroupName="cilj" Content="DOMENSKI GPO" Margin="0,0,16,0"
                                 ToolTip="Objava u GPO na domain controlleru (traži RSAT i prava za uređivanje GPO-a)."/>
                    <StackPanel x:Name="pnlRemote" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBox x:Name="txtComputers" Width="420" Tag="Nazivi računala odvojeni zarezom, npr. PC01, PC02"/>
                    </StackPanel>
                    <StackPanel x:Name="pnlDomain" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBox x:Name="txtGpoName" Width="190" Tag="Naziv GPO-a" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtLinkTarget" Width="270" Tag="Poveži na OU (DN), opcionalno" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtApplyGroup" Width="170" Tag="Samo za grupu, opcionalno" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtDomain" Width="140" Tag="Domena (prazno = ova)"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- ===== Glavni dio: navigacija + stranice + traka radnji ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,10,0,14">
                    <TextBlock DockPanel.Dock="Top" Text="NAVIGACIJA" Style="{StaticResource EyebrowPrigusen}" Margin="18,0,18,6" Height="24"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,16,18,0">
                        <TextBlock x:Name="txtVersion" Text="VERZIJA" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Muted2}"/>
                        <TextBlock Text="WWW.AUXILIUM.HR" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton x:Name="navPregled" Style="{StaticResource NavStavka}" Tag="PR" Content="PREGLED" IsChecked="True"/>
                        <RadioButton x:Name="navSigurnost" Style="{StaticResource NavStavka}" Tag="SI" Content="SIGURNOSNE POSTAVKE"/>
                        <RadioButton x:Name="navPreseti" Style="{StaticResource NavStavka}" Tag="PS" Content="PRESETI"/>
                        <RadioButton x:Name="navUsporedba" Style="{StaticResource NavStavka}" Tag="ST" Content="USPOREDBA"/>
                        <RadioButton x:Name="navPromjene" Style="{StaticResource NavStavka}" Tag="PM" Content="PROMJENE"/>
                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="18,10"/>
                        <RadioButton x:Name="navNapredno" Style="{StaticResource NavStavka}" Tag="GP" Content="NAPREDNO (GPEDIT)"/>
                        <RadioButton x:Name="navDnevnik" Style="{StaticResource NavStavka}" Tag="&gt;_" Content="DNEVNIK"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ PREGLED ============ -->
                <ScrollViewer x:Name="pgPregled" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,18">
                        <TextBlock Text="Odaberite razinu zaštite" Style="{StaticResource Naslov}" FontSize="22"/>
                        <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,4,0,14" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="Razina odabire skup provjerenih postavki. Svaku postavku možete kasnije uključiti ili isključiti na stranici Sigurnosne postavke. Ništa se ne mijenja dok ne kliknete Primijeni, a prije primjene uvijek se radi sigurnosna kopija."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="rbLevel1" Grid.Column="0" Style="{StaticResource RazinaKartica}" GroupName="razina">
                                <StackPanel>
                                    <TextBlock Text="RAZINA 1" Style="{StaticResource EyebrowPrigusen}"/>
                                    <TextBlock Text="OSNOVNO" Style="{StaticResource Naslov}" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,6,0,0" Text="Najvažnije zaštite koje korisnici gotovo ne primjećuju. Za male urede i računala bez osjetljivih podataka."/>
                                    <TextBlock x:Name="txtLevel1Count" Style="{StaticResource Sitno}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rbLevel2" Grid.Column="1" Style="{StaticResource RazinaKartica}" GroupName="razina" IsChecked="True">
                                <StackPanel>
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource OznakaTocka}" Foreground="{StaticResource Green}" Content="PREPORUKA" Margin="0"/>
                                        <TextBlock Text="RAZINA 2" Style="{StaticResource EyebrowPrigusen}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="PREPORUČENO" Style="{StaticResource Naslov}" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,6,0,0" Text="Poslovna razina blizu CIS razine 1 i Microsoftovog sigurnosnog baselinea. Za većinu tvrtki."/>
                                    <TextBlock x:Name="txtLevel2Count" Style="{StaticResource Sitno}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rbLevel3" Grid.Column="2" Style="{StaticResource RazinaKartica}" GroupName="razina" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="RAZINA 3" Style="{StaticResource EyebrowPrigusen}"/>
                                    <TextBlock Text="STROGO" Style="{StaticResource Naslov}" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,6,0,0" Text="Za osjetljive podatke i računala izložena riziku. Korisnici će primijetiti ograničenja (USB, makronaredbe, udaljeni pristup)."/>
                                    <TextBlock x:Name="txtLevel3Count" Style="{StaticResource Sitno}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="BRZI ODABIR" Style="{StaticResource EyebrowPrigusen}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <WrapPanel x:Name="pnlQuickPresets" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <HeaderedContentControl Grid.Column="0" Style="{StaticResource Kartica}">
                                <HeaderedContentControl.Header>
                                    <DockPanel>
                                        <TextBlock x:Name="txtSummaryNote" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="10"/>
                                        <TextBlock Text="ŠTO ĆE SE POSTAVITI"/>
                                    </DockPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel>
                                    <TextBlock x:Name="txtSelectionTitle" Style="{StaticResource Naslov}" FontSize="15"/>
                                    <TextBlock x:Name="txtSelectionInfo" Style="{StaticResource Sitno}" Margin="0,2,0,10"/>
                                    <StackPanel x:Name="pnlSummary"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Style="{StaticResource Kartica}" Header="USKLAĐENOST SA STANDARDIMA">
                                <StackPanel>
                                    <UniformGrid x:Name="pnlScoresOverview" Columns="3"/>
                                    <TextBlock Style="{StaticResource Nagovjestaj}" Margin="0,10,0,0"
                                               Text="Postotak se računa samo za preporuke koje GPO Studio poznaje, ne za cijeli standard. Nije potvrda sukladnosti."/>
                                    <Button x:Name="btnOverviewCompare" Style="{StaticResource GumbPoveznica}" Content="Detaljna usporedba po postavkama" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </HeaderedContentControl>
                        </Grid>

                        <Border Style="{StaticResource OkvirSavjet}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="SAVJET" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Green}"/>
                                <TextBlock Style="{StaticResource Tekst}" Margin="0,3,0,0"
                                           Text="Kliknite Pregledaj promjene da vidite što će se točno promijeniti na računalu. Ako nešto ne radi kako treba, Vrati prethodno stanje vraća postavke iz sigurnosne kopije."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SIGURNOSNE POSTAVKE ============ -->
                <Grid x:Name="pgSigurnost" Grid.Row="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="0,16,0,8">
                            <TextBlock DockPanel.Dock="Top" Text="PODRUČJA" Style="{StaticResource EyebrowPrigusen}" Margin="18,0,18,8"/>
                            <ListBox x:Name="lbCategories"/>
                        </DockPanel>
                    </Border>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="22,16,22,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="btnResetToLevel" Style="{StaticResource GumbTraka}" Content="VRATI NA RAZINU" Margin="0,0,6,0"
                                            ToolTip="Poništava ručne promjene i vraća postavke odabrane razine."/>
                                    <Button x:Name="btnSavePresetFromControls" Style="{StaticResource GumbTraka}" Content="SPREMI KAO PRESET"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="txtCategoryTitle" Style="{StaticResource Naslov}" FontSize="20"/>
                                    <TextBlock x:Name="txtCategoryDesc" Style="{StaticResource TekstPrigusen}" Margin="0,3,0,0" MaxWidth="820" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBox x:Name="txtControlSearch" Width="300" Tag="Traži postavku u svim područjima…" Margin="0,0,14,0"/>
                                <RadioButton x:Name="rbFilterAll" Style="{StaticResource Segment}" GroupName="filter" Content="SVE" IsChecked="True"/>
                                <RadioButton x:Name="rbFilterSelected" Style="{StaticResource Segment}" GroupName="filter" Content="UKLJUČENE"/>
                                <RadioButton x:Name="rbFilterChanged" Style="{StaticResource Segment}" GroupName="filter" Content="RUČNO PROMIJENJENE"/>
                            </WrapPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="svControls" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnlControls" Margin="22,0,22,16"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ============ PRESETI ============ -->
                <DockPanel x:Name="pgPreseti" Grid.Row="0" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="22,18,22,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="btnPresetImport" Content="UVEZI PRESET" Margin="0,0,8,0"/>
                                <Button x:Name="btnPresetSave" Style="{StaticResource GumbPrimarni}" Content="SPREMI TRENUTNI ODABIR"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Preseti" Style="{StaticResource Naslov}" FontSize="22"/>
                                <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"
                                           Text="Preset je spremljen odabir: razina zaštite i vaše promjene. Učitajte gotov preset za tipična računala ili spremite vlastiti predložak i koristite ga na drugim računalima."/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="txtPresetFolder" Style="{StaticResource Nagovjestaj}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="pnlPresets" Margin="22,6,12,16"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- ============ USPOREDBA SA STANDARDIMA ============ -->
                <DockPanel x:Name="pgUsporedba" Grid.Row="0" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="22,18,22,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="btnExportReport" Content="IZVEZI IZVJEŠTAJ" Margin="0,0,8,0"
                                        ToolTip="Sprema usporedbu kao HTML izvještaj koji se može ispisati ili poslati."/>
                                <Button x:Name="btnUseState" Content="PREUZMI KAO ODABIR" Margin="0,0,8,0" IsEnabled="False"
                                        ToolTip="Postavlja odabir na stanje pronađeno na računalu, da ga možete doraditi i ponovno primijeniti."/>
                                <Button x:Name="btnCheckComputer" Style="{StaticResource GumbPrimarni}" Content="PROVJERI RAČUNALO"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Usporedba sa sigurnosnim standardima" Style="{StaticResource Naslov}" FontSize="22"/>
                                <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"
                                           Text="Usporedite svoj odabir ili stvarno stanje računala s CIS benchmarkom za Windows 11 (razine 1 i 2) i Microsoftovim sigurnosnim baselineom."/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="IZVOR" Style="{StaticResource EyebrowPrigusen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton x:Name="rbCmpSelection" Style="{StaticResource Segment}" GroupName="izvor" Content="MOJ ODABIR" IsChecked="True"/>
                            <RadioButton x:Name="rbCmpState" Style="{StaticResource Segment}" GroupName="izvor" Content="STANJE RAČUNALA" IsEnabled="False" Margin="0,0,24,0"/>
                            <TextBlock Text="STANDARD" Style="{StaticResource EyebrowPrigusen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <WrapPanel x:Name="pnlStandardFilter"/>
                        </WrapPanel>
                        <TextBlock x:Name="txtStateInfo" Style="{StaticResource Sitno}" Margin="0,8,0,0"/>
                        <UniformGrid x:Name="pnlScoresCompare" Columns="3" Margin="0,12,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Nagovjestaj}" Margin="22,6,22,10" x:Name="txtCompareNote"/>
                    <DataGrid x:Name="dgCompliance" Margin="22,4,22,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PODRUČJE" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="POSTAVKA" Binding="{Binding Control}" Width="2*"/>
                            <DataGridTextColumn Header="STANDARD" Binding="{Binding Source}" Width="90"/>
                            <DataGridTextColumn Header="PREPORUKA" Binding="{Binding Recommendation}" Width="2*"/>
                            <DataGridTextColumn Header="ODABIR / STANJE" Binding="{Binding SelectedText}" Width="*"/>
                            <DataGridTemplateColumn Header="STATUS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK"><Setter Property="Foreground" Value="{StaticResource Green}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Deviates"><Setter Property="Foreground" Value="{StaticResource Red}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NotSet"><Setter Property="Foreground" Value="{StaticResource Amber}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- ============ PROMJENE (rezultat pregleda / primjene) ============ -->
                <DockPanel x:Name="pgPromjene" Grid.Row="0" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="22,18,22,8">
                        <TextBlock x:Name="txtChangesTitle" Text="Promjene" Style="{StaticResource Naslov}" FontSize="22"/>
                        <TextBlock x:Name="txtChangesInfo" Style="{StaticResource TekstPrigusen}" Margin="0,4,0,0" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="Ovdje se prikazuje što će se promijeniti (Pregledaj promjene) ili što je promijenjeno (Primijeni)."/>
                        <WrapPanel x:Name="pnlChangeChips" Margin="0,12,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="dgChanges" Margin="22,4,22,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CILJ" Binding="{Binding Target}" Width="120"/>
                            <DataGridTemplateColumn Header="STATUS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Added"><Setter Property="Foreground" Value="{StaticResource Green}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Changed"><Setter Property="Foreground" Value="{StaticResource Amber}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Removed"><Setter Property="Foreground" Value="{StaticResource Cyan}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Planned"><Setter Property="Foreground" Value="{StaticResource Cyan}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="POSTAVKA" Binding="{Binding Setting}" Width="2*"/>
                            <DataGridTextColumn Header="TRENUTNO" Binding="{Binding Current}" Width="*"/>
                            <DataGridTextColumn Header="NOVO" Binding="{Binding Desired}" Width="*"/>
                            <DataGridTextColumn Header="TEHNIČKI ZAPIS" Binding="{Binding Technical}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- ============ NAPREDNO: katalog ADMX politika (kao gpedit) ============ -->
                <Grid x:Name="pgNapredno" Grid.Row="0" Visibility="Collapsed" Margin="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <HeaderedContentControl Grid.Column="0" Style="{StaticResource Kartica}" Header="KATALOG POLITIKA (ADMX)">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button x:Name="btnLoadCatalog" DockPanel.Dock="Right" Style="{StaticResource GumbTraka}" Content="UČITAJ" Margin="6,0,0,0"/>
                                <TextBox x:Name="txtAdmxPath" Tag="Mapa ADMX predložaka (prazno = Central Store / sustav)"/>
                            </DockPanel>
                            <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Tag="Traži po nazivu, kategoriji ili ključu…" Margin="0,0,0,8"/>
                            <TreeView x:Name="tvCatalog"/>
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="2" Style="{StaticResource Kartica}" Header="NAPREDNI POLICY SET">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="NAZIV" Style="{StaticResource EyebrowPrigusen}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtSetName" Text="Novi Policy Set"/>
                            </DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button x:Name="btnEnable" Style="{StaticResource GumbTraka}" Content="DODAJ: UKLJUČENO" Margin="0,0,6,6"/>
                                <Button x:Name="btnDisable" Style="{StaticResource GumbTraka}" Content="DODAJ: ISKLJUČENO" Margin="0,0,6,6"/>
                                <Button x:Name="btnRemove" Style="{StaticResource GumbTraka}" Content="UKLONI ODABRANO" Margin="0,0,6,6"/>
                                <Button x:Name="btnOpen" Style="{StaticResource GumbTraka}" Content="OTVORI…" Margin="0,0,6,6"/>
                                <Button x:Name="btnSave" Style="{StaticResource GumbTraka}" Content="SPREMI…" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Nagovjestaj}" Margin="0,8,0,0"
                                       Text="Dok je otvorena ova stranica, gumbi Pregledaj promjene i Primijeni rade s naprednim Policy Setom, ne sa sigurnosnim postavkama."/>
                            <DataGrid x:Name="dgSettings">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="POSTAVKA" Binding="{Binding displayName}" Width="2*"/>
                                    <DataGridTextColumn Header="SCOPE" Binding="{Binding scope}" Width="70"/>
                                    <DataGridTextColumn Header="KLJUČ" Binding="{Binding key}" Width="2*"/>
                                    <DataGridTextColumn Header="VRIJEDNOST" Binding="{Binding valueName}" Width="*"/>
                                    <DataGridTextColumn Header="PODATAK" Binding="{Binding data}" Width="70"/>
                                    <DataGridTextColumn Header="RADNJA" Binding="{Binding action}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="4" Style="{StaticResource Kartica}" Header="DETALJI">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="txtPolicyTitle" Style="{StaticResource Tekst}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="txtPolicyMeta" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                <TextBlock x:Name="txtExplain" Style="{StaticResource Tekst}" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </HeaderedContentControl>
                </Grid>

                <!-- ============ DNEVNIK ============ -->
                <DockPanel x:Name="pgDnevnik" Grid.Row="0" Visibility="Collapsed" Margin="16,14,16,10">
                    <DockPanel DockPanel.Dock="Top" Margin="6,4,6,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnCopyLog" Style="{StaticResource GumbTraka}" Content="KOPIRAJ" Margin="0,0,6,0"/>
                            <Button x:Name="btnClearLog" Style="{StaticResource GumbTraka}" Content="OČISTI"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Dnevnik" Style="{StaticResource Naslov}" FontSize="22"/>
                            <TextBlock Style="{StaticResource TekstPrigusen}" Margin="0,4,0,0"
                                       Text="Svaka radnja i ekvivalentna PowerShell naredba. Revizijski zapis primjena nalazi se u C:\ProgramData\GpoStudio\audit.jsonl."/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{StaticResource Void}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <ScrollViewer x:Name="svLog" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,8">
                            <ItemsControl x:Name="lstLog" FontFamily="Consolas" FontSize="12.5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Command"><Setter Property="Foreground" Value="{StaticResource Cyan}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource Green}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource Amber}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{StaticResource Red}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- ============ Traka radnji (vrijedi za otvorenu stranicu) ============ -->
                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnReplication" Content="PROVJERI REPLIKACIJU" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button x:Name="btnBackup" Content="SIGURNOSNA KOPIJA" Margin="0,0,8,0"/>
                            <Button x:Name="btnRestore" Content="VRATI PRETHODNO STANJE" Margin="0,0,8,0"/>
                            <Button x:Name="btnDiff" Content="PREGLEDAJ PROMJENE" Margin="0,0,8,0"/>
                            <Button x:Name="btnApply" Style="{StaticResource GumbPrimarni}" Content="PRIMIJENI"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRIMJENJUJE SE" Style="{StaticResource EyebrowPrigusen}" FontSize="10"/>
                            <TextBlock x:Name="txtActionSource" Style="{StaticResource Tekst}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Statusna traka ===== -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" TextBlock.FontFamily="{StaticResource FontMono}" TextBlock.FontSize="10.5">
                <TextBlock x:Name="stClock" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GPO STUDIO" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="  |  " Foreground="{StaticResource Muted2}"/>
                    <TextBlock x:Name="stState" Text="SPREMNO" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="CILJ" Foreground="{StaticResource Muted}" Margin="22,0,8,0"/>
                    <TextBlock x:Name="stTarget" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="ODABIR" Foreground="{StaticResource Muted}" Margin="22,0,8,0"/>
                    <TextBlock x:Name="stSelection" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="stMessage" Foreground="{StaticResource Muted}" Margin="22,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
