<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPO Studio" Height="760" Width="1280" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cilj primjene -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                    <TextBlock Text="Cilj" FontWeight="SemiBold"/>
                    <RadioButton x:Name="rbLocal" Content="Lokalni GP (računala)" IsChecked="True" Margin="0,4,0,0"/>
                    <RadioButton x:Name="rbDomain" Content="Domenski GPO (DC)" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <StackPanel x:Name="pnlLocal" Orientation="Vertical">
                        <TextBlock Text="Računala (odvojena zarezom; prazno = ovo računalo)"/>
                        <TextBox x:Name="txtComputers" Margin="0,4,0,0" ToolTip="npr. PC01, PC02, KIOSK-03"/>
                    </StackPanel>
                    <Grid x:Name="pnlDomain" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Domena (prazno = trenutna)"/>
                            <TextBox x:Name="txtDomain" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Naziv GPO-a"/>
                            <TextBox x:Name="txtGpoName" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Poveži na (DN OU-a, opcionalno)"/>
                            <TextBox x:Name="txtLinkTarget" Margin="0,4,0,0" ToolTip="OU=Racunala,DC=firma,DC=local"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Primijeni samo na grupu"/>
                            <TextBox x:Name="txtApplyGroup" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Akcije i status -->
        <Border DockPanel.Dock="Bottom" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btnDiff" Content="Usporedi (diff)"/>
                    <Button x:Name="btnApply" Content="Primijeni" FontWeight="SemiBold"/>
                    <Button x:Name="btnBackup" Content="Backup"/>
                    <Button x:Name="btnRestore" Content="Vrati iz backupa…"/>
                    <Button x:Name="btnReplication" Content="Provjeri replikaciju"/>
                </StackPanel>
                <ProgressBar x:Name="pbBusy" DockPanel.Dock="Right" Width="120" Height="14" IsIndeterminate="True" Visibility="Hidden"/>
                <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="12,0" Text="Spremno." TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Katalog ADMX politika -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Katalog politika" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="btnLoadCatalog" DockPanel.Dock="Right" Content="Učitaj" MinWidth="60" Margin="6,0,0,0"/>
                    <TextBox x:Name="txtAdmxPath" ToolTip="Mapa s ADMX predlošcima; prazno = Central Store ili %windir%\PolicyDefinitions"/>
                </DockPanel>
                <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Margin="0,0,0,4" ToolTip="Pretraga po nazivu, kategoriji ili registry ključu"/>
                <TreeView x:Name="tvCatalog"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- Policy Set / Diff / Log -->
            <TabControl Grid.Column="2" x:Name="tabMain">
                <TabItem Header="Policy Set">
                    <DockPanel Margin="6">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Naziv:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtSetName" Text="Novi Policy Set"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="btnEnable" Content="Dodaj: Enabled"/>
                            <Button x:Name="btnDisable" Content="Dodaj: Disabled"/>
                            <Button x:Name="btnRemove" Content="Ukloni"/>
                            <Button x:Name="btnOpen" Content="Otvori JSON…"/>
                            <Button x:Name="btnSave" Content="Spremi JSON…"/>
                        </StackPanel>
                        <DataGrid x:Name="dgSettings" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Postavka" Binding="{Binding displayName}" Width="2*"/>
                                <DataGridTextColumn Header="Scope" Binding="{Binding scope}" Width="Auto"/>
                                <DataGridTextColumn Header="Akcija" Binding="{Binding action}" Width="Auto"/>
                                <DataGridTextColumn Header="Ključ" Binding="{Binding key}" Width="2*"/>
                                <DataGridTextColumn Header="Vrijednost" Binding="{Binding valueName}" Width="*"/>
                                <DataGridTextColumn Header="Tip" Binding="{Binding type}" Width="Auto"/>
                                <DataGridTextColumn Header="Podaci" Binding="{Binding data}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Diff" x:Name="tabDiff">
                    <DataGrid x:Name="dgDiff" Margin="6" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Added"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Changed"><Setter Property="Background" Value="#FEF9C3"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Removed"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cilj" Binding="{Binding Target}" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto"/>
                            <DataGridTextColumn Header="Ključ" Binding="{Binding Key}" Width="2*"/>
                            <DataGridTextColumn Header="Vrijednost" Binding="{Binding ValueName}" Width="*"/>
                            <DataGridTextColumn Header="Trenutno" Binding="{Binding Current}" Width="*"/>
                            <DataGridTextColumn Header="Željeno" Binding="{Binding Desired}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Log" x:Name="tabLog">
                    <TextBox x:Name="txtLog" Margin="6" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

            <!-- Detalji politike -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Detalji" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtPolicyTitle" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtPolicyMeta" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock x:Name="txtExplain" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
